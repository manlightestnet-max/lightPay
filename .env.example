# ==========================================================
# LIGHTWALLET CORE ENGINE — CONFIGURATION ENVIRONNEMENT
# ==========================================================

# Port d'écoute du serveur
PORT=8080
HOST=0.0.0.0

# Environnement ('development' ou 'production')
NODE_ENV=development

# Clé Super-Admin Maîtresse (Obligatoire pour créer des apps et auditer le grand livre)
MASTER_ADMIN_KEY=dev_master_key_change_in_production

# Devise par défaut de l'écosystème
DEFAULT_CURRENCY=XAF

# URL de connexion PostgreSQL
# Si PostgreSQL est hors-ligne en local, LightWallet bascule automatiquement
# sur le moteur en mémoire vive (Zero-Config Sandbox Mode).
# Pour persister en base réelle, décommentez et renseignez l'URL ci-dessous :
# DATABASE_URL=postgresql://postgres:votre_mot_de_passe@localhost:5432/lightwallet
# DATABASE_URL=postgres://user:password@ep-cool-flower.neon.tech/lightwallet?sslmode=require
